  "mitigations": [
    { "id": "buy_insurance", "text": "Purchase event cancellation and liability insurance immediately.", "factorIds": ["downside_severity", "external_volatility"], "deltaLikelihood": -3, "effort": 2 },
    { "id": "secure_tents", "text": "Rent waterproof tents or secure an indoor backup venue.", "factorIds": ["weather_contingency", "external_volatility"], "deltaLikelihood": -4, "effort": 3 },
    { "id": "vendor_contracts", "text": "Review vendor contracts for force majeure and refund clauses.", "factorIds": ["vendor_reliability", "dependency_exposure"], "deltaLikelihood": -2, "effort": 1 },
    { "id": "emergency_fund", "text": "Set aside 15% of the budget as an emergency buffer.", "factorIds": ["resource_adequacy"], "deltaLikelihood": -2, "effort": 3 }
  ]
